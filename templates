<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>自由な漫画サイト - 認証</title>
    <style>
        body { font-family: sans-serif; max-width: 400px; margin: 50px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; background-color: #f8f9fa; }
        .form-group { margin-bottom: 15px; position: relative; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .password-container { position: relative; }
        .toggle-password { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; background: none; border: none; font-size: 14px; color: #666; padding: 0; width: auto; }
        button.submit-btn { width: 100%; padding: 10px; color: white; border: none; border-radius: 4px; cursor: pointer; margin-bottom: 10px; font-size: 16px; }
        .btn-login { background-color: #007bff; }
        .btn-register { background-color: #28a745; }
        .message { padding: 10px; background-color: #ffeef0; border: 1px solid #fecdd3; margin-bottom: 15px; border-radius: 4px; color: #dc2626; font-size: 14px; }
        .hint { font-size: 12px; color: #666; margin-top: 5px; }
    </style>
</head>
<body>
    <h2>漫画サイト 認証</h2>
    
    {% if message %}
    <div class="message" style="color: #155724; background-color: #d4edda; border-color: #c3e6cb;" id="msg-box">{{ message }}</div>
    {% endif %}

    <form method="POST" action="/">
        <div class="form-group">
            <label for="username">ユーザー名</label>
            <input type="text" id="username" name="username" required minlength="3" maxlength="15" placeholder="3〜15文字">
        </div>
        <div class="form-group">
            <label for="password">パスワード</label>
            <div class="password-container">
                <input type="password" id="password" name="password" required minlength="12" placeholder="12文字以上推奨">
                <button type="button" id="togglePassword" class="toggle-password">👁️ 表示</button>
            </div>
            <div class="hint">※安全のため、12文字以上の強力なパスワードにしてください</div>
        </div>
        
        <div class="form-group" style="margin-top: 25px; padding-top: 15px; border-top: 1px dashed #ccc;">
            <label for="admin_key" style="color: #666; font-size: 13px;">管理者登録コード（一般ユーザーは不要）</label>
            <input type="password" id="admin_key" name="admin_key" placeholder="管理者として登録する場合のみ入力">
        </div>

        <button type="submit" name="action" value="login" class="submit-btn btn-login">ログイン</button>
        <button type="submit" name="action" value="register" class="submit-btn btn-register">新規アカウント登録</button>
    </form>

    <script>
        // パスワードの目玉アイコン（表示・非表示切り替え）
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password');
        togglePassword.addEventListener('click', function () {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.textContent = type === 'password' ? '👁️ 表示' : '🔒 隠す';
        });

        // エラーメッセージがある場合、赤い文字にする（ログアウト以外）
        const msgBox = document.getElementById('msg-box');
        if (msgBox && !msgBox.textContent.includes('ログアウト')) {
            msgBox.style.color = '#dc2626';
            msgBox.style.backgroundColor = '#ffeef0';
            msgBox.style.borderColor = '#fecdd3';
        }
    </script>
</body>
</html>
